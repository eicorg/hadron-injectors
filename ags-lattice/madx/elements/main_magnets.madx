/*
  The AGS main magnets are RBENDS.  This files treats the main magnets as 
    SBENDS with the entrance and exit faces rotates via E1, E2 statements to
    have the shape of RBENDS.  It also includes the K1 and K2 component
    directly into the element definition.  As such if you include this file
    it is unnecessary to include xags.rbends_add_k1k2, which treats the 
    multipole components as 'errors' (via EFCOMP statements) on the main field.
*/




//!4.3 Dipole Names
// bnlmad uses RBEND's, correctly, but not CERN mad8, so old = bnlmad versions
//ADold: RBEND,L := LENA,ANGLE := ANGA,K1 := K1AD,K2 := K2AD!,Aperx=.07296,Apery=.04088
//AFold: RBEND,L := LENA,ANGLE := ANGA,K1 := K1AF,K2 := K2AF!,Aperx=.07296,Apery=.04088
//BDold: RBEND,L := LENB,ANGLE := ANGB,K1 := K1BD,K2 := K2BD!,Aperx=.07296,Apery=.04088
//BFold: RBEND,L := LENB,ANGLE := ANGB,K1 := K1BF,K2 := K2BF!,Aperx=.07296,Apery=.04088
//CDold: RBEND,L := LENC,ANGLE := ANGC,K1 := K1CD,K2 := K2CD!,Aperx=.07296,Apery=.04088
//CFold: RBEND,L := LENC,ANGLE := ANGC,K1 := K1CF,K2 := K2CF!,Aperx=.07296,Apery=.04088


CONV := 0.0254;
LENA:= 94*CONV; !length in meters
LENB:= 79*CONV;
LENC:= 94*CONV;

ANGA := 0.0279650307*CCbit; //angle in radians, CCbit = +1 means clockwise AGS, -1 means counter.
ANGB := 0.0235023009*CCbit;
ANGC := 0.0279650307*CCbit;

AD: RBEND,L := LENA,ANGLE := ANGA; // ,K1 := K1AD,K2 := K2AD; // ,E1 := ANGA/2.,E2 := ANGA/2.;
AF: RBEND,L := LENA,ANGLE := ANGA; // ,K1 := K1AF,K2 := K2AF; // ,E1 := ANGA/2.,E2 := ANGA/2.;
BD: RBEND,L := LENB,ANGLE := ANGB; // ,K1 := K1BD,K2 := K2BD; // ,E1 := ANGB/2.,E2 := ANGB/2.;
BF: RBEND,L := LENB,ANGLE := ANGB; // ,K1 := K1BF,K2 := K2BF; // ,E1 := ANGB/2.,E2 := ANGB/2.;
CD: RBEND,L := LENC,ANGLE := ANGC; // ,K1 := K1CD,K2 := K2CD; // ,E1 := ANGC/2.,E2 := ANGC/2.;
CF: RBEND,L := LENC,ANGLE := ANGC; // ,K1 := K1CF,K2 := K2CF; // ,E1 := ANGC/2.,E2 := ANGC/2.;

MM_A01BF : RBEND,L := LENB,ANGLE := ANGB,K1 := K1BF,K2 := K2BF*CCbit; //,E1 := ANGB/2.,E2 := ANGB/2.;
MM_A02BF : RBEND,L := LENB,ANGLE := ANGB,K1 := K1BF,K2 := K2BF*CCbit; //,E1 := ANGB/2.,E2 := ANGB/2.;
