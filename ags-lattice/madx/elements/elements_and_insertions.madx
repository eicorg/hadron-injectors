// Mechanically extracted from source/madx/xags.lattice:1-1102; do not change physics here.
option, echo;
//!   "ags.lattice"
//
//STANDARD AGS
//         Initial, Standard  High-Field AGS, Auerbach
//         April 6, 1994, Pue's added, Auerbach
//         December 20-21, 1995, Developed as beam line, Bleser
//         March 1, 1996, put in new gradiant formulas, K1AD4, etc, Sect. 4
//         March 20, 1996, put in new gradiants for tune quads, Sect. 6
//         Sept 18, 1996 complete installing vertical steerers, Sect. 13
//	  March 3, 1997 install positive drive sextupoles in E5 and K5.
//	  March 3, 1997 install negative drive sextupoles in B5 and H5.
//	  March 3, 1997 install horizontal chromatic sextupoles in all
//	                 SS13 ie add them in C, F, I, and L.
//	  March 5, 1997 add apertures to main magnet definitions
//	 		use COPY for MM names
//	 march 19,197 temp remove sex B,D,F,H,J,L
//        april 3, 1997 restore sex B,D,F,H,J,L
//        May 22, 1998 Add horizontal steerers, Section 14
//        May 22, 1998 prepare section 0.0 for studying Extraction Bumps for Soukas
//        Save standard file as BACKUPAGS
//
//        SEB Modifications - Kevin Brown
//        August 31, 1998 Added SEB Septa and new Lines
//
//        August 21, 2003 converted to cern mad8 format


// August 9 05, changed nomenclature for most elements to be roughly of the form:
//  (type)_(location), where type i ssomething like MM, QH, QS for main magnet,
//   horizontal tune quad and skew quad respectivel and location is a main 
//   magnet name (A3, L20, etc)

// April 07, 2009: Adding a bit to 'flip' the AGS.  AGS main bends have heretofore
//      bent positive beam to the right, which is clockwise, which is how the AGS beam
//      looks if you lay on your back and look up.  For matching to BtA and AtR, it's better
//      to have a counterclockwise bend (need to multiply dipoles and sextupole kicks by -1).
//      No effect on most optics, flips the sign of the dispersion.
//      I call the bit "CCbit".  Positive 1 will be clockwise, negative with be counterclockwise.
//      I've chosen to put the bit in the element definition, NOT in the transfer functions. -- schoefer



//
//!0.0     INDEX
//         0.  INDEX
//        00.  Special test
//         1.  INTRODUCTION
//         2.  STANDARD SETTINGS
//         3.
//         4.  AGS MAIN MAGNETS
//         5.  STRAIGHT SECTIONS
//         6.  TUNE QUADRUPOLES
//         7.  SKEW QUADRUPOLES
//         8.  TRANSITION QUADRUPOLES
//         9.  POLARISATION QUADRUPOLES
//        10.  CHROMATICITY SEXTUPOLES
//        11.  DRIVE SEXTUPOLES
//        12.  PICK UP ELECTRODES
//        13.  VERTICAL STEERING MAGNETS 
//        14.  HORIZONTAL STEERING MAGNETS
//	 15.  Extraction Kickers and elements
LENA := 94*CONV ; //length in meters
LENB := 79*CONV;
LENC := 94*CONV;
LENQ := 0.39088; // 15.4- in.
LENS := 0.655  ; //  25.8 in.
CONV := 0.0254          ; // inches --> meters
LQThin:= 0.35;


//==============
//!1.1     Introduction
// 1.2     This configuration sets up the AGS with a line for each magnet.
//         It is intended to allow for inserting all the various AGS devices.
//         It uses Auerbach's basic geometry and Tanaka's fit to the momentum.

//!2.1   Standard settings
//================
//        In "FrunAGS" we set the parameters for the AGS devices.  In principle 
//        the user never needs to set anything in "AGS.CONFIG" which is intended
//        to cover all standard AGS running conditions.
//!2.2 AGS Momentum
//         In "FrunAGS" the momentum of the beam must be specified.
//                                  MOM:= P(GeV/c)
//         In Section 4 the main magnet propereties are calculated from the 
//         Chosen momentum.
//
//!2.3 BDOT effect  :=  Added by K. Brown (8/31/98)
//	  Another variable used for calculating the sextupole moments of the
//	  main magnets is B-dot.  It is specified by,
//				   BDOT := dB/dt (T/sec)
//  	  For information on BDOT effects see AGS Tech. Note 288 (and 276)
// initializations

BDOT := 0.0     ; //initialize to zero
/*
XQH := 0.0     ; // Horizontal Quads current
XQV := 0.0     ; // Vertical Quads current
XQS := 0.0     ; // Skew Quads current
XSH := 0.0     ; // Horizontal Sextupole current
XSV := 0.0     ; // Vertical Sextupole current
XSD := 0.0     ; // Drive Sextupole current
*/

//!5.0    Straight Sections
//=================
D2SL := 23.99664 *CONV ;
D2TL := 23.99548 *CONV ;
D2LL := 23.99428 *CONV ;
D2HL := 29.99714 *CONV ;
D5LL := 59.99428 *CONV ;
D10L := 59.99367 *CONV ;
d10ltot = 2.0*d10l;

//
D2S: DRIFT, L := 23.99664 *CONV ;
D2T: DRIFT, L := 23.99548 *CONV ;
D2L: DRIFT, L := 23.99428 *CONV ;
D2H: DRIFT, L := 29.99714 *CONV ;
D5L: DRIFT, L := 59.99428 *CONV ;
D10: DRIFT, L := 59.99367 *CONV ;
D10SKH: DRIFT, L:=(59.99367*CONV-1.5); //For snake insert

D2H_NuJ: DRIFT, L := (29.99714 *CONV) - (0.8128)/2; // New drift length for the I5/J5 straight sections
                                                    // , which now have horiz tune jump quads for p^.
                                                    // Quad len = 0.8128;



DSQm35 : DRIFT, L:= (D5LL/2) -LENQ-0.35;
DSQm7   : DRIFT, L:= (D5LL/2) -LENQ-0.07;
D7cm      : DRIFT, L:= 0.07;
//
//! Half Straigth Sections
D2SH: DRIFT, L := (D2SL/2.);
D2TH: DRIFT, L := (D2TL/2.);
D2LH: DRIFT, L := (D2LL/2.);
D2HH: DRIFT, L := (D2HL/2.);
D5LH: DRIFT, L := (D5LL/2.);
D10H: DRIFT, L := (D10L/2.);
//
//------------------------------------------------
// Special Drifts For SEB - K.Brown (8/31/98)
//
// 4/12/99 Added drifts for G10 and E05 kickers
//
LES := 2.25     ; // length of H20 electrostatic septum
LF05 := 0.66     ; // length of F5 magnetic septum
LF10 := 2.03     ; // total length of F10 magnetic septum
LG10 := 2.413    ; // total length of G10 kicker 
LVB20 := 0.762    ; // total length of F20 and G20 vertical bumps

DSG10: DRIFT, L := (D10L-LG10/2.);
DSF05: DRIFT, L := (D2HL-LF05/2.);
DSF10: DRIFT, L := (D10L-LF10/2.);
DSH10: DRIFT, L := (D10L-LF10/2.);
DSH20: DRIFT, L := (D10L-LES/2.);
// parameter versions
DSG10p := (D10L-LG10/2.);
DSF05p := (D2HL-LF05/2.);
DSF10p := (D10L-LF10/2.);
DSH10p := (D10L-LF10/2.);
DSH20p := (D10L-LES/2.);
//
DSF20U: DRIFT, L := (0.5207) ; // F20 is located 23.5" DS - iron to iron - from MM_F20BD face
DSF20D: DRIFT, L := (D10L-0.5207-LVB20);
DSF20:  DRIFT, L := (D10L);
DSG20:  DRIFT, L := (D10L)    ; // G20 is located 15.5" US - iron to iron - from MM_H01BF face
DSG20U: DRIFT, L := (D10L-LVB20-0.3175);
DSG20D: DRIFT, L := (0.3175);

D2SX: DRIFT, L:= (23.99664*CONV-LQThin)/2;


//------------------------------------------------
//

//! 6.0 Tune Quadrupoles
//=================
//    The current in the tune quads is set by XQH and XQV in "FrunAGS"
//    The horizontal tune quads are in each SS17.
//    The vertical tune quads are in each SS03.
//    Downstream of each tune quad is a polarisation, skew, or transition quad
//    Install B1QH, B1QV  on 3/20/96, see Tech Note ??

// defined in ags.conversions
//LENQ := 0.39088       ! 15.4- in.

//QHFH: QUADRUPOLE, L := LENQ, K1 := KQH
//QHFV: QUADRUPOLE, L := LENQ, K1 := KQV

/*
QV_A03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_A17 : QUADRUPOLE, L := LENQ, K1 := KQH_A17; // Two power supplies (tune + cold snake compensation)

QV_B03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_B17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_C03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_C17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_D03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_D17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_E03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_E17 : QUADRUPOLE, L := LENQ, K1 := KQH_E17; // Two power supplies (tune + cold snake compensation)

QV_F03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_F17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_G03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_G17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_H03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_H17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_I03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_I17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_J03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_J17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_K03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_K17 : QUADRUPOLE, L := LENQ, K1 := KQH;

QV_L03 : QUADRUPOLE, L := LENQ, K1 := KQV;
QH_L17 : QUADRUPOLE, L := LENQ, K1 := KQH;
*/

QV_A03 : QUADRUPOLE, L := LENQ, K1 := KQV_A03;
QH_A17 : QUADRUPOLE, L := LENQ, K1 := KQH_A17; // Two power supplies (tune + cold snake compensation)

QV_B03 : QUADRUPOLE, L := LENQ, K1 := KQV_B03;
QH_B17 : QUADRUPOLE, L := LENQ, K1 := KQH_B17;

QV_C03 : QUADRUPOLE, L := LENQ, K1 := KQV_C03;
QH_C17 : QUADRUPOLE, L := LENQ, K1 := KQH_C17;

QV_D03 : QUADRUPOLE, L := LENQ, K1 := KQV_D03;
QH_D17 : QUADRUPOLE, L := LENQ, K1 := KQH_D17;

QV_E03 : QUADRUPOLE, L := LENQ, K1 := KQV_E03;
QH_E17 : QUADRUPOLE, L := LENQ, K1 := KQH_E17; // Two power supplies (tune + cold snake compensation)

QV_F03 : QUADRUPOLE, L := LENQ, K1 := KQV_F03;
QH_F17 : QUADRUPOLE, L := LENQ, K1 := KQH_F17;

QV_G03 : QUADRUPOLE, L := LENQ, K1 := KQV_G03;
QH_G17 : QUADRUPOLE, L := LENQ, K1 := KQH_G17;

QV_H03 : QUADRUPOLE, L := LENQ, K1 := KQV_H03;
QH_H17 : QUADRUPOLE, L := LENQ, K1 := KQH_H17;

QV_I03 : QUADRUPOLE, L := LENQ, K1 := KQV_I03;
QH_I17 : QUADRUPOLE, L := LENQ, K1 := KQH_I17;

QV_J03 : QUADRUPOLE, L := LENQ, K1 := KQV_J03;
QH_J17 : QUADRUPOLE, L := LENQ, K1 := KQH_J17;

QV_K03 : QUADRUPOLE, L := LENQ, K1 := KQV_K03;
QH_K17 : QUADRUPOLE, L := LENQ, K1 := KQH_K17;

QV_L03 : QUADRUPOLE, L := LENQ, K1 := KQV_L03;
QH_L17 : QUADRUPOLE, L := LENQ, K1 := KQH_L17;




//!7.0   Skew Quads
//=============
//         The current in the skew quads is set by XQS
//         Here we define the skew values directly as a K1S (S:= skew) rather than a 'tilt'

QS_B17: QUADRUPOLE, L := LENQ, K1S := KQS_B17;
QS_D17: QUADRUPOLE, L := LENQ, K1S := KQS_D17;
QS_F17: QUADRUPOLE, L := LENQ, K1S := KQS_F17;
QS_H17: QUADRUPOLE, L := LENQ, K1S := KQS_H17;
QS_J17: QUADRUPOLE, L := LENQ, K1S := KQS_J17;
QS_L17: QUADRUPOLE, L := LENQ, K1S := KQS_L17;




//    The skew quads are in SS17 in superperiods B,D,F,H,J,L
//    The length of the straight section is given by D5L
//    We place the quads centered in the SS with no gap between them
//    Then:

DSQ: DRIFT, L := D5LL/2 - LENQ;

//    The insertion becomes
//    DSQ,QH*17,QHFS,DSQ, where * is the relevant superperiod

//!8.0 Transition Quads
//===============
//       KGTR in "FrunAGS" sets the gradient of the transition quads

QGTR1A: QUADRUPOLE, L := LENQ, K1 := KGQHPa;
QGTR1E: QUADRUPOLE, L := LENQ, K1 := KGQHPe;
QGTR1I: QUADRUPOLE, L := LENQ, K1 := KGQHPi;
QGTR2C: QUADRUPOLE, L := LENQ, K1 := KGQHNc;
QGTR2G: QUADRUPOLE, L := LENQ, K1 := KGQHNg;
QGTR2K: QUADRUPOLE, L := LENQ, K1 := KGQHNk;

//    The positive transition quads are in SS17 in superperiods A, E, and I
//    The negative transition quads are in SS17 in superperiods C, G, and K
//    The length of the straight section is given by D5L
//    We place the quads centered in the SS with no gap between them
//    For the positive quads the insertion in A, E, and I is:
//    DSQ,QH*17,QGTR1,DSQ, where * is the relevant superperiod
//    For the negative quads the insertion in C, G, and K is:
//    DSQ,QH*17,QGTR2,DSQ, where * is the relevant superperiod.

//!9.0   Polarisation Quads
//==================
//       KPOL in "FrunAGS" sets the gradient of the polarisation quads

QPOL: QUADRUPOLE, L := LENQ, K1 := KPOL;

/*
QP_A03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_B03: QUADRUPOLE, L := LENQ, K1 := KPOL_B03;
QP_C03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_D03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_E03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_F03: QUADRUPOLE, L := LENQ, K1 := KPOL_F03;
QP_G03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_H03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_I03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_J03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_K03: QUADRUPOLE, L := LENQ, K1 := KPOL;
QP_L03: QUADRUPOLE, L := LENQ, K1 := KPOL;
*/


QP_A03: QUADRUPOLE, L := LENQ, K1 := KPOL_A03;
QP_B03: QUADRUPOLE, L := LENQ, K1 := KPOL_B03;
QP_C03: QUADRUPOLE, L := LENQ, K1 := KPOL_C03;
QP_D03: QUADRUPOLE, L := LENQ, K1 := KPOL_D03;
QP_E03: QUADRUPOLE, L := LENQ, K1 := KPOL_E03;
QP_F03: QUADRUPOLE, L := LENQ, K1 := KPOL_F03;
QP_G03: QUADRUPOLE, L := LENQ, K1 := KPOL_G03;
QP_H03: QUADRUPOLE, L := LENQ, K1 := KPOL_H03;
QP_I03: QUADRUPOLE, L := LENQ, K1 := KPOL_I03;
QP_J03: QUADRUPOLE, L := LENQ, K1 := KPOL_J03;
QP_K03: QUADRUPOLE, L := LENQ, K1 := KPOL_K03;
QP_L03: QUADRUPOLE, L := LENQ, K1 := KPOL_L03;

//    The polarisation quads are in all SS03
//    The insertion is:
//    DSQ,QV*3,QPOL,DSQ, where * is the relevant superperiod.


//===============================================================
// Horizontal tune jump quads (for p^ horizontal resonance jumps) 5/13/09 vhs
//  shortened names from QHNuJump_x05 to QJump_x05 to satisfy SPRINT code 2/5/2018
//===============================================================

LEN_HNuJump := 0.8128;

QJump_I05 : Quadrupole, L := LEN_HNuJump, K1 := KHNuJump_I05;
QJump_J05 : Quadrupole, L := LEN_HNuJump, K1 := KHNuJump_J05;

//===================================================================
// Cold and warm snakes defined as drifts by default.
//===================================================================
// CSNK: sextupole, L:=3.0, k2:=0.0001;                   //Placeholder for Cold snake.
csnk_mark : marker;
CSNK1: MARKER;
CSNK2: sextupole, L:=3.0, k2:=1e-10;

//csnk2: drift, l=3;
CSNK3: MARKER;

csnk: line:= (csnk1, csnk2, csnk3);

//WSNK: sextupole, L:=3.0, k2:=0;                   // Placeholder for Warm snake.
//WSNK: drift, l=3;
WSNK: sextupole, L:=3.0, k2:=1e-10;



//==================================================================
// Thin 'Courant' quadrupoles for cold snake compensation
//==================================================================

LQThin:= 0.35;	// Length of thin quads

QThin_A19: quadrupole, L:= LQThin  , k1 := KThin_A19;
QThin_B01: quadrupole, L:= LQThin  , k1 := Kthin_B01;


//==================================================================
// Thin quadrupoles for warm snake compensation
//==================================================================

// Same as thin quads for cold snake

QThin_E19: quadrupole, L:= LQThin  , k1 := KThin_E19;
QThin_F01: quadrupole, L:= LQThin  , k1 := Kthin_F01;


//!10.0 Chromaticity Sextupoles
//======================
//     XSH and XSV in "FrunAGS" set the currents in the chromaticity sextupoles

// defined in ags.conversions
//LENS := 0.655        !  25.8 in.

SXH  : SEXTUPOLE,  L := LENS, K2 := SXHC * CCbit;
SXV  : SEXTUPOLE,  L := LENS, K2 := SXVC * CCbit;

SXHU  : SEXTUPOLE,  L := LENS/2, K2 := SXHC * CCbit;
SXHD  : SEXTUPOLE,  L := LENS/2, K2 := SXHC * CCbit;

//    The vertical sextupoles are in all the SS07
//    The horizontal sextupoles are all in the 13 position.


SXH_A13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_B13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_C13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_D13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_E13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_F13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_G13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_H13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_I13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_J13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_K13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;
SXH_L13: SEXTUPOLE, L := LENS, K2 := SXHC * CCbit;

SXV_A07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_B07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_C07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_D07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_E07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_F07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_G07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_H07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_I07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_J07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_K07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;
SXV_L07: SEXTUPOLE, L := LENS, K2 := SXVC * CCbit;






DSS: DRIFT, L := (D5LL-LENS)/2.;

//    The insertion becomes:
//    DSS, SXV_*7, DSS, where * is the relevant superperiod

//    The horizontal sextupoles are in all SS13 (installed 3/3/97)
//    The insertion becomes:
//    DSS, SXH_*13, DSS, where * is the relevant superperiod


//!11.0   Drive Sextupoles
//=================
// XSD in "FrunAGS" sets the current in the drive sextupoles

SXDP: SEXTUPOLE,  L := LENS, K2 := -SXDC * CCbit;
SXDN: SEXTUPOLE,  L := LENS, K2 := SXDC * CCbit;

SXDP_E05 : SEXTUPOLE, L := LENS, K2 := -SXDC * CCbit;
SXDP_K05 : SEXTUPOLE, L := LENS, K2 := -SXDC * CCbit;

SXDN_B05 : SEXTUPOLE, L := LENS, K2 := SXDC * CCbit;
SXDN_H05 : SEXTUPOLE, L := LENS, K2 := SXDC  * CCbit;

//    The positive drive sextupoles are in E5 and K5 (INSTALLED 3/3/97)
//    The insertions are:
//    DSS, SXDP, DSS

//    The negative drive sextupoles are in B5 and H5 (INSTALLED 3/3/97)
//    The insertions are:
//    DSS, SXDN, DSS




//!12.0 Pick up electrodes
//=================
DPUE:   DRIFT, L := 0.287;
D2TX:   DRIFT, L := D2TL-0.287;
D2LX:   DRIFT, L := D2LL-0.287;


PUE_A02:   MONITOR;
PUE_A04:   MONITOR;
PUE_A08:   MONITOR;
PUE_A12:   MONITOR;
PUE_A14:   MONITOR;
PUE_A18:   MONITOR;

PUE_B02:   MONITOR;
PUE_B04:   MONITOR;
PUE_B08:   MONITOR;
PUE_B12:   MONITOR;
PUE_B14:   MONITOR;
PUE_B18:   MONITOR;

PUE_C02:   MONITOR;
PUE_C04:   MONITOR;
PUE_C08:   MONITOR;
PUE_C12:   MONITOR;
PUE_C14:   MONITOR;
PUE_C18:   MONITOR;

PUE_D02:   MONITOR;
PUE_D04:   MONITOR;
PUE_D08:   MONITOR;
PUE_D12:   MONITOR;
PUE_D14:   MONITOR;
PUE_D18:   MONITOR;

PUE_E02:   MONITOR;
PUE_E04:   MONITOR;
PUE_E08:   MONITOR;
PUE_E12:   MONITOR;
PUE_E14:   MONITOR;
PUE_E18:   MONITOR;

PUE_F02:   MONITOR;
PUE_F04:   MONITOR;
PUE_F08:   MONITOR;
PUE_F12:   MONITOR;
PUE_F14:   MONITOR;
PUE_F18:   MONITOR;
WB_PUE_F20:   MONITOR; // Wide band pick up electrode. (Not in AgsOrbitDisplay)

PUE_G02:   MONITOR;
PUE_G04:   MONITOR;
PUE_G08:   MONITOR;
PUE_G12:   MONITOR;
