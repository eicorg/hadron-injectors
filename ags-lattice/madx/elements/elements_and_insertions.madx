DVCL08: VKICKER, L := 0.0, KICK:=DVCL08KICK;
DVCL12: VKICKER, L := 0.0, KICK:=DVCL12KICK;
DVCL18: VKICKER, L := 0.0, KICK:=DVCL18KICK;

//Due to the author's inelegant programming all the DVC---KICK's
//must now de defined.  Those that are being used are reset in FrunAGS

DVCA02KICK: = k_cal * DVC_A02_I;
DVCA08KICK: = k_cal * DVC_A08_I;
DVCA12KICK: = k_cal * DVC_A12_I;
DVCA18KICK: = k_cal * DVC_A18_I;
DVCB02KICK: = k_cal * DVC_B02_I;
DVCB08KICK:  = k_cal * DVC_B08_I;
