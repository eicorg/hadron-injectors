//==============================================================================
// RF Cavities
//  2/5/2018 Just adding one cavity at B20 ("Cavity BC") for now and associated drifts
//   
//==============================================================================

D10RF: DRIFT, L := 59.99367 *CONV -0.5;
RFBC : RFCAVITY, L=1.0, VOLT=0.0, FREQ=4.0;

//!!  LINES
//========
//========
//A05KICKER: MARKER;
A05KICKER: HKICKER, L:=0, KICK:=A05KICK;

J10DUMP: MARKER;
C05IPM: MARKER;
E15IPM: MARKER;

// 11/21/13 - kab, Steve Tepikian
//  added new electron-collector IPMs
// Model the eipms as a kickers to enable beta function measurment simulation -- vhs 8/2/2017
D05EIPM: HKICKER, L := 0.0, KICK:=D05EIPMKICK;
D15EIPM: VKICKER, L := 0.0, KICK:=D15EIPMKICK;



//===================================================================================
// H10toH13 for extraction
//   Extracted beam travels through the fringe of the AGS main magnets between H10 and H13
//   This matrix includes the effects of H10 and transports from the entrance to H10 to the start of AtR
//===================================================================================

R11T2:= 2.2886 ;
R12T2:= 14.523 ;
R21T2:= 0.26387;
R22T2:= 2.1114 ;
DT2:=   0.1566 ;
DPT2:=  0.0156 ;

ET2:=R21T2*DT2-R11T2*DPT2;
FT2:=R22T2*DT2-R12T2*DPT2;

R33T2:= 0.050902;
R34T2:= 6.2687  ;
R43T2:=-0.15730 ;
R44T2:= 0.19950 ;

MH10H13: MATRIX, TYPE=TSNAKE,L=9.9309 ,//
 RM11= R11T2 ,//
 RM12= R12T2 ,//
 RM13=  0.000 ,//
 RM14=  0.000 ,//
 RM15=  0. ,//
 RM16=  DT2 ,//
 RM21=  R21T2 ,//
 RM22=  R22T2 ,//
 RM23=  0.0000 ,//
 RM24=  0.0000 ,//
 RM25=  0. ,//
 RM26=  DPT2 ,//
 RM31= -0.0000 ,//
 RM32= -0.0000 ,//
 RM33=  R33T2 ,//
 RM34=  R34T2   ,//
 RM35=  0. ,//
 RM36= -0.000 ,//
 RM41=  0.000 ,//
 RM42=  0.000 ,//
 RM43=  R43T2  ,//
 RM44=  R44T2 ,//
 RM45=  0. ,//
 RM46= -0. ,//
 RM51=  ET2  ,// !1474 ,// ! -0.01474
 RM52=  FT2  ,// !1514 ,//  ! -0.1514
 RM53=  0. ,//
 RM54= -0. ,//
 RM55=  1. ,//
 RM56= -0. ,//
 RM61=  0. ,//
 RM62=  0. ,//
 RM63=  0. ,//
 RM64=  0. ,//
 RM65=  0. ,//
 RM66=  1.;


H10toH13: Line:=(MH10H13);

// =====================================
//   INSTRUMENTATION
// =====================================

mwa15: marker;

TUNEKICK_H: TKICKER, L=0.0, HKICK=0.0;
TUNEKICK_V: TKICKER, L=0.0, VKICK=0.0;
TUNEMETER_PUE   : MONITOR, L=0.0;

// ==========
// Definition for pulsed skew quads 3/7/2024
//  Pulse Skew Quadrupoles for Spin Resonance Correction
//  Motivation: Phys. Rev. Accel. Beams 24, 031001 
// =========

LQS_hres = 0.169418;


qshres_A10: quadrupole, l:=LQS_hres, K1S := Khres_A10;
qshres_B07: quadrupole, l:=LQS_hres, K1S := Khres_B07;
qshres_C07: quadrupole, l:=LQS_hres, K1S := Khres_C07;
qshres_C20: quadrupole, l:=LQS_hres, K1S := Khres_C20;
qshres_D07: quadrupole, l:=LQS_hres, K1S := Khres_D07;
qshres_E05: quadrupole, l:=LQS_hres, K1S := Khres_E05;
qshres_F07: quadrupole, l:=LQS_hres, K1S := Khres_F07;
qshres_F20: quadrupole, l:=LQS_hres, K1S := Khres_F20;
qshres_G20: quadrupole, l:=LQS_hres, K1S := Khres_G20;
qshres_H05: quadrupole, l:=LQS_hres, K1S := Khres_H05;
qshres_H20: quadrupole, l:=LQS_hres, K1S := Khres_H20;
qshres_I07: quadrupole, l:=LQS_hres, K1S := Khres_I07;
qshres_K05: quadrupole, l:=LQS_hres, K1S := Khres_K05;
qshres_K07: quadrupole, l:=LQS_hres, K1S := Khres_K07;
qshres_K15: quadrupole, l:=LQS_hres, K1S := Khres_K15;


!========================================================
! Modified drifts for the pulsed skew quads:
!========================================================

DA10_1: drift, l = 89.990505*conv-LQS_hres/2.0;
DA10_2: drift, l = d10ltot-(89.990505*conv)-LQS_hres/2.0;

DB07_1: drift, l = d5ll-lens-LQS_hres;
DC07_1: drift, l = d5ll-lens-LQS_hres;
DD07_1: drift, l = d5ll-lens-LQS_hres;
DE05_1: drift, l = d5ll-lens-LQS_hres;
DF07_1: drift, l = d5ll-lens-LQS_hres;
DH05_1: drift, l = d5ll-lens-LQS_hres;
DI07_1: drift, l = d5ll-lens-LQS_hres;
DK05_1: drift, l = d5ll-lens-LQS_hres;
DK07_1: drift, l = d5ll-lens-LQS_hres;

DK15_1: drift, l=d2hl-LQS_hres/2.0;
DK15_2: drift, l=d2hl-LQS_hres/2.0;

DC20_1: drift, l=D10l-LQS_hres/2.0;
DC20_2: drift, l=D10l-LQS_hres/2.0;

DF20_1: drift, l=D10l-LQS_hres/2.0;
DF20_2: drift, l=D10l-LQS_hres/2.0;

DG20_1: drift, L=d10l/2.0-LQS_hres/2.0;
DG20_2: drift, L=d10l/2.0-LQS_hres/2.0;

DH20_1: drift, l=D10l-LQS_hres/2.0;
DH20_2: drift, l=D10l-LQS_hres/2.0;



