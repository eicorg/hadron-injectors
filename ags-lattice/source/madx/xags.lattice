//------------------------------------------------------------
//!	 15.0  Extraction Kickers and elements, and sublines
//		K. Brown (8/31/98)
//
//        4/12/99 - Added G10 and E05 kickers for fast extraction
//		   to SEB lines.
//------------------------------------------------------------

ESH20:  HKICKER, L := LES,    Kick:= H20kick * CCbit;
SMF05:  HKICKER, L := LF05,   Kick:= F05kick * CCbit;
SMF10:  HKICKER, L := LF10,   Kick:= F10kick * CCbit;
SMF10a: HKICKER, L := LF10/2, Kick:= F10kick/2 * CCbit;
SMF10b: HKICKER, L := LF10/2, Kick:= F10kick/2 * CCbit;
SMH10a: HKICKER, L := LF10/2, Kick:= H10kick/2 * CCbit;
SMH10b: HKICKER, L := LF10/2, Kick:= H10kick/2 * CCbit;

//D2LX:   DRIFT, L := D2LL-0.287

F10K1:  QUADRUPOLE,  L := 0.1, K1 := F10Qk1;
H10K1:  QUADRUPOLE,  L := 0.1, K1 := H10Qk1;
DSH10n: DRIFT, L := DSH10p-0.1;
DSF10n: DRIFT, L := DSF10p-0.1;

//  the rest are all the same magnet  different locations
//  SMG10  Hkick	 L := LG10  Kick:= G10tkick, cuts="> X2", xc=,-0.05


G10Marker: marker;
SMG10: HKICKER, L := LG10,  Kick := G10tkick;


//SMA5:  HKICKER, L := LG10,  Kick:= A5kick
//SMA10: HKICKER, L := LG10,  Kick:= A10kick
//SMA20: HKICKER, L := LG10,  Kick:= A20kick
//SMB10: HKICKER, L := LG10,  Kick:= B10kick
//SMB20: HKICKER, L := LG10,  Kick:= B20kick
//SMC10: HKICKER, L := LG10,  Kick:= C10kick
//SMC20: HKICKER, L := LG10,  Kick:= C20kick
//SMD10: HKICKER, L := LG10,  Kick:= D10kick
//SMD20: HKICKER, L := LG10,  Kick:= D20kick
//SME10: HKICKER, L := LG10,  Kick:= E10kick
//SME20: HKICKER, L := LG10,  Kick:= E20kick
//SMF20: HKICKER, L := LG10,  Kick:= F20kick
//SMG10: HKICKER, L := LG10,  Kick:= G10tkick
//SMG20: HKICKER, L := LG10,  Kick:= G20tkick
//SMH20: HKICKER, L := LG10,  Kick:= H20fkick
//SMI10: HKICKER, L := LG10,  Kick:= I10kick
//SMI20: HKICKER, L := LG10,  Kick:= I20kick
//SMJ10: HKICKER, L := LG10,  Kick:= J10kick
//SMJ20: HKICKER, L := LG10,  Kick:= J20kick
//SMK10: HKICKER, L := LG10,  Kick:= K10kick
//SMK20: HKICKER, L := LG10,  Kick:= K20kick
//SML10: HKICKER, L := LG10,  Kick:= L10kick
//SML20: HKICKER, L := LG10,  Kick:= L20kick

// High field Vertical bumps.  10/1/03 KAB
  F20VK:=(1./BRHO)*0.0002657*F20VBI;
  G20VK:=(1./BRHO)*0.0002657*G20VBI;
  SKF20: VKICKER, L := LVB20, Kick:= F20VK;
  SKG20: VKICKER, L := LVB20, Kick:= G20VK;

F16MID:  MARKER;
F17MID: MARKER;
F18MID: MARKER;
F19MID: MARKER;
F20MID: MARKER;
G2MID:  MARKER;
G3MID:  MARKER;
G4MID:  MARKER;
G5MID:  MARKER;
G6MID:  MARKER;
G7MID:  MARKER;

H5MID:  MARKER;
H6MID:  MARKER;
H7MID:  MARKER;
H8MID:  MARKER;
H9MID:  MARKER;
H10MID: MARKER;
H20USF: MARKER;
H10USF: MARKER;
H10DSF: MARKER;
F5USF:  MARKER;
SSF05:   Line:= (F5USF, SMF05, DSF05);
SSH10:   Line:= (DSH10n, H10USF,SMH10a,H10MID,H10K1,SMH10b,H10DSF,DSH10);
SSF10:   Line:= (DSF10n, SMF10a,F10K1,SMF10b);
//  SSF10   Line:= (DSF10, SMF10)
SSH20:   Line:= (H20USF,ESH20,DSH20);
//-------------------------------------------------------------
SSA10:   Line:= (DSG10, SMA10);
SSA20:   Line:= (DSG10, SMA20);
SSB10:   Line:= (DSG10, SMB10);
SSB20:   Line:= (DSG10, SMB20);
SSC10:   Line:= (DSG10, SMC10);
SSC20:   Line:= (DSG10, SMC20);
SSD10:   Line:= (DSG10, SMD10);
SSD20:   Line:= (DSG10, SMD20);
SSE10:   Line:= (DSG10, SME10);
SSE20:   Line:= (DSG10, SME20);
//SSF20:   Line:= (DSG10, SMF20)
SSF20:   Line:= (DSF20U, SKF20,DSF20D)  ; // now has f20 vertical bump 10/1/03 KAB
SSG10:   Line:= (DSG10, G10Marker, SMG10); // DSG10 + SMG10 + DSG10:= G10 straight section
//SSG20:   Line:= (DSG10, SMG20)
SSG20:   Line:= (DSG20U, SKG20,DSG20D);
SSH20f:  Line:= (DSG10, SMH20);
SSI10:   Line:= (DSG10, SMI10);
SSI20:   Line:= (DSG10, SMI20);
SSJ10:   Line:= (DSG10, SMJ10);
SSJ20:   Line:= (DSG10, SMJ20);
SSK10:   Line:= (DSG10, SMK10);
SSK20:   Line:= (DSG10, SMK20);
SSL10:   Line:= (DSG10, SML10);
SSL20:   Line:= (DSG10, SML20);

