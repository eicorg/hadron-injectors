//13.0  NEW LOW FIELD STEERING MAGNETS

//	Start to install 9/13/96
//	magnets are 6 inches long with an 8.7 inch gap
//	both horizontally and vertically
//	each of the 4 sides has 160 turns on it
//	in 2 layers
//	The peak current is 25 amps
//	The maximum continuous current is 12.5 Amps
//	The strength is 1.2 kilogauss-inches
//	The naming convention is DHC or DVC followed by the location
//	They are in the 2,8, 12, and 18 locations
//       The KICK is specified in radians


k_cal := -0.000037 * (7.67/BRHO) * CCbit; // Calibration for the steerers (hor and ver) in radians/A.



DVCA02: VKICKER, L := 0.0, KICK:=DVCA02KICK;
DVCA08: VKICKER, L := 0.0, KICK:=DVCA08KICK;
DVCA12: VKICKER, L := 0.0, KICK:=DVCA12KICK;
DVCA18: VKICKER, L := 0.0, KICK:=DVCA18KICK;
DVCB02: VKICKER, L := 0.0, KICK:=DVCB02KICK;
DVCB08: VKICKER, L := 0.0, KICK:=DVCB08KICK;
DVCB12: VKICKER, L := 0.0, KICK:=DVCB12KICK;
DVCB18: VKICKER, L := 0.0, KICK:=DVCB18KICK;
DVCC02: VKICKER, L := 0.0, KICK:=DVCC02KICK;
DVCC08: VKICKER, L := 0.0, KICK:=DVCC08KICK;
DVCC12: VKICKER, L := 0.0, KICK:=DVCC12KICK;
DVCC18: VKICKER, L := 0.0, KICK:=DVCC18KICK;
DVCD02: VKICKER, L := 0.0, KICK:=DVCD02KICK;
DVCD08: VKICKER, L := 0.0, KICK:=DVCD08KICK;
DVCD12: VKICKER, L := 0.0, KICK:=DVCD12KICK;
DVCD18: VKICKER, L := 0.0, KICK:=DVCD18KICK;
DVCE02: VKICKER, L := 0.0, KICK:=DVCE02KICK;
DVCE08: VKICKER, L := 0.0, KICK:=DVCE08KICK;
DVCE12: VKICKER, L := 0.0, KICK:=DVCE12KICK;
DVCE18: VKICKER, L := 0.0, KICK:=DVCE18KICK;
DVCF02: VKICKER, L := 0.0, KICK:=DVCF02KICK;
DVCF08: VKICKER, L := 0.0, KICK:=DVCF08KICK;
DVCF12: VKICKER, L := 0.0, KICK:=DVCF12KICK;
DVCF18: VKICKER, L := 0.0, KICK:=DVCF18KICK;
DVCG02: VKICKER, L := 0.0, KICK:=DVCG02KICK;
DVCG08: VKICKER, L := 0.0, KICK:=DVCG08KICK;
DVCG12: VKICKER, L := 0.0, KICK:=DVCG12KICK;
DVCG18: VKICKER, L := 0.0, KICK:=DVCG18KICK;
DVCH02: VKICKER, L := 0.0, KICK:=DVCH02KICK;
DVCH08: VKICKER, L := 0.0, KICK:=DVCH08KICK;
DVCH12: VKICKER, L := 0.0, KICK:=DVCH12KICK;
DVCH18: VKICKER, L := 0.0, KICK:=DVCH18KICK;
DVCI02: VKICKER, L := 0.0, KICK:=DVCI02KICK;
DVCI08: VKICKER, L := 0.0, KICK:=DVCI08KICK;
DVCI12: VKICKER, L := 0.0, KICK:=DVCI12KICK;
DVCI18: VKICKER, L := 0.0, KICK:=DVCI18KICK;
DVCJ02: VKICKER, L := 0.0, KICK:=DVCJ02KICK;
DVCJ08: VKICKER, L := 0.0, KICK:=DVCJ08KICK;
DVCJ12: VKICKER, L := 0.0, KICK:=DVCJ12KICK;
DVCJ18: VKICKER, L := 0.0, KICK:=DVCJ18KICK;
DVCK02: VKICKER, L := 0.0, KICK:=DVCK02KICK;
DVCK08: VKICKER, L := 0.0, KICK:=DVCK08KICK;
DVCK12: VKICKER, L := 0.0, KICK:=DVCK12KICK;
DVCK18: VKICKER, L := 0.0, KICK:=DVCK18KICK;
DVCL02: VKICKER, L := 0.0, KICK:=DVCL02KICK;
DVCL08: VKICKER, L := 0.0, KICK:=DVCL08KICK;
DVCL12: VKICKER, L := 0.0, KICK:=DVCL12KICK;
DVCL18: VKICKER, L := 0.0, KICK:=DVCL18KICK;

//Due to the author's inelegant programming all the DVC---KICK's
//must now de defined.  Those that are being used are reset in FrunAGS

DVCA02KICK: = k_cal * DVC_A02_I;
DVCA08KICK: = k_cal * DVC_A08_I;
DVCA12KICK: = k_cal * DVC_A12_I;
DVCA18KICK: = k_cal * DVC_A18_I;
DVCB02KICK: = k_cal * DVC_B02_I;
DVCB08KICK:  = k_cal * DVC_B08_I;
DVCB12KICK:  = k_cal * DVC_B12_I;
