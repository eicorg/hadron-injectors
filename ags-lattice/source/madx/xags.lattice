DVCF08KICK:  = k_cal * DVC_F08_I;
DVCF12KICK:  = k_cal * DVC_F12_I;
DVCF18KICK:  = k_cal * DVC_F18_I;
DVCG02KICK:  = k_cal * DVC_G02_I;
DVCG08KICK:  = k_cal * DVC_G08_I;
DVCG12KICK:  = k_cal * DVC_G12_I;
DVCG18KICK:  = k_cal * DVC_G18_I;
DVCH02KICK:  = k_cal * DVC_H02_I;
DVCH08KICK:  = k_cal * DVC_H08_I;
DVCH12KICK:  = k_cal * DVC_H12_I;
DVCH18KICK:  = k_cal * DVC_H18_I;
DVCI02KICK:  = k_cal * DVC_I02_I;
DVCI08KICK:  = k_cal * DVC_I08_I;
DVCI12KICK:  = k_cal * DVC_I12_I;
DVCI18KICK:  = k_cal * DVC_I18_I;
DVCJ02KICK:  = k_cal * DVC_J02_I;
DVCJ08KICK:  = k_cal * DVC_J08_I;
DVCJ12KICK:  = k_cal * DVC_J12_I;
DVCJ18KICK:  = k_cal * DVC_J18_I;
