/*
Bumps in this online model are tricky, since the quad and sextupole moments
of the main magnets are treated as errors.  

These error statements ADD to pre-existing errors.
The error statements defining the intrinsic multipole components of the main magnets
  REPLACE pre-existing errors with new ones.  Thus if one calls
  xags.rbends_add_k1k2 to change the focusing in the mains, one 
  must call this file again in order to re-implement the bumps represented
  here.



NOTES ON THE IMPLEMENTATION OF BACKLEG WINDINGS ON THE MAIN MAGNET.
!-------------------------------------------------------------------------
!Notes from 2/5/98 from calculations made by Nick Tsoupas and Kevin Brown.
!
! from beam and opera (AGS model and modelling of AGS magnets)
! we have found the following:
!
! kick(A,C) = 5*Ibump*27.9650307*P(25.61)/(Imm * P(now))
!    and
! kick(B)   = 0.99156*kick(A,C)
!    or
! kick(B)   = 6*Ibump*23.5013009*P(25.61)/(Imm * P(now))
!
! From opera, we find that for P=25.61 GeV/c, that Imm = 71398 amp
!
!  In addition, there is a 0.5 % relative increase in Imm for P=4 GeV/c.
!
! For relative field errors, we must know what percentage change in bend angle
! to impose, for a given Ibump.  DKN(0) is the relative change in bend
! angle to make.  So if the bend angle is normally 27.965 mrad, and
! the kick is 0.5875 mrad from the bumps, then DKN(0) should be
! the ratio of the kick to the normal bend angle, or 0.0210.   
!
! So the expression to use for backlegs is:
!         DBLR(A,C) = nturns*I_blw*25.61/(71398*P(now))
!                   = 1.793468E-03 * I_blw/MOM
!         DBLR(B)   = nturns*I_blw*25.61/(71398*P(now))
!		    = 2.152161E-03 * I_blw/MOM
!---------------------------------------------------------------------
*/

// General formula for backlegs: 
//    Rel change in angle = 3.586936e-4 * nturns * I_blw/MOM

blw_c := 3.586936e-4;  // coeff for general blw
 
// Calibration constants for specific magnets:
/*
a16_c = 0.0005185627;	// meas. 1/19/06
a17_c = 0.0005185627;	// meas. 1/19/06
a18_c = 0.0005185627;	// meas. 1/19/06
a19_c = 0.0005141915;	// meas. 1/19/06

b02_c = 0.0004190811;	// meas. 1/19/06
b03_c = 0.0004473412;	// meas. 1/19/06
b04_c = 0.0004473412;	// meas. 1/19/06
b05_c = 0.0004473412;	// meas. 1/19/06

a20_c = 0.0004190811;	// meas. 1/19/06
*/

/*
a16_c = 0.000431082/0.0008333327806;	// meas. 1/19/06
a17_c = 0.000431082;	// meas. 1/19/06
a18_c = 0.000431082;	// meas. 1/19/06
a19_c = 0.000431082;	// meas. 1/19/06


a16_c = 0.0005172987431;
a17_c = 0.0005172987431;
a18_c = 0.0005172987431;
a19_c = 0.0005172987431;
*/


 /* My cal
a16_c := 3.44895e-4; 
a17_c := 3.44895e-4;
a18_c := 3.44895e-4;
a19_c := 3.44895e-4;


b02_c = 2.49622e-4;	// meas. 1/19/06
b03_c = 2.49622e-4;	// meas. 1/19/06
b04_c = 2.49622e-4;	// meas. 1/19/06
b05_c = 2.49622e-4;	// meas. 1/19/06

a20_c =  2.17841e-4;	// meas. 1/19/06
*/

// NT cal
a16_c := 3.44895e-4*1.54464; 
a17_c := 3.44895e-4*1.54464;
a18_c := 3.44895e-4*1.54464;
a19_c := 3.44895e-4*1.54464;

b02_c = 2.49622e-4*2.132506;	// meas. 1/19/06
b03_c = 2.49622e-4*2.132506;	// meas. 1/19/06
b04_c = 2.49622e-4*2.132506;	// meas. 1/19/06
b05_c = 2.49622e-4*2.132506;	// meas. 1/19/06

a20_c =  2.17841e-4*1.92383757;	// meas. 1/19/06


//Test converting NT values from elog 09

a16_c :=  3.62624e-4;
a17_c :=  3.62624e-4;
a18_c :=  3.62624e-4;
a19_c :=  3.63115e-4;

b02_c :=  3.63115e-4;
b03_c :=  3.62624e-4;
b04_c :=  3.62624e-4;
b05_c :=  3.62624e-4;

a20_c :=  3.63115e-4;

/*
a16_c :=  blw_c;
a17_c :=   blw_c;
a18_c :=   blw_c;
a19_c :=   blw_c;

b02_c :=   blw_c;
b03_c :=   blw_c;
b04_c :=   blw_c;
b05_c :=   blw_c;

a20_c :=   blw_c;
*/

value, MOM;

value, a16_c;
value, ANGA;
eoption, add=true;



L20dip=0;

csnkDip = 0;

//========================================================================
// Cold Snake a16-19_blw bump.  Backlegs on A16, A17, -A18, -A19 in series.
//========================================================================

//a16-19_blw_I = cur in blw 16-19



select, flag=error, clear=true;
select, flag=error, range=MM_A16AD;
  n = 10; 		// turns.
  I = a16_19_blw_I; 	// current.
  bmp = (a16_c)*n*I/(MOM*NN/Q) ;  // relative change.
  dk1 = -k1ad*bmp;
efcomp,order:=0, radius:= 1,  DKN := {ANGA*bmp*csnkDip, dk1*csnkK1};
print, text="A16";
value, bmp*ANGA;
value, MOM;




select, flag=error, clear=true;
select, flag=error, range=MM_A17CF;
  n = 10; 		// turns.
  I = a16_19_blw_I; 	// current.
  bmp = a17_c*n*I/(MOM*NN/Q);  // relative change.
  dk1 = k1cf*bmp;
efcomp, order:=0, radius:=1, DKN := {ANGC*bmp*csnkDip, dk1*csnkK1};

select, flag=error, clear=true;
select, flag=error, range=MM_A18CF;
  n = 10; 			// turns.
  I = -1* a16_19_blw_I; 	// current.
  bmp = a18_c*n*I/(MOM*NN/Q);  	// relative change.
  dk1 = k1cf*bmp;
efcomp, order:=0, radius:=1, DKN := {ANGC*bmp*csnkDip, dk1*csnkK1};

select, flag=error, clear=true;
select, flag=error, range=MM_A19BD;
  n = 12; 			// turns.
  I = -1* a16_19_blw_I; 	// current.
  bmp = a19_c*n*I/(MOM*NN/Q);  	// relative change.
  dk1 = -k1bd*bmp;
efcomp, order:=0, radius:=1, DKN := {ANGB*bmp*csnkDip, dk1*csnkK1};


//------------------------------------------------------------------

