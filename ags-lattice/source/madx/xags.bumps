//================================================================
// Cold Snake A20 blw. Backleg wired only on A20, 12 turns.
//	Note: There are three power supplies wired on A20, but the controls
//	      system (currently) combines them into one total current which
//	      we use here.
//================================================================

select, flag=error, clear=true;
select, flag=error, range=MM_A20BD;
  n := 12; 			// turns.
  I := A20_BLW_I; 	// current.
  bmp := a20_c*n*I/(MOM*NN/Q);  	// relative change.
  dk1 = -k1bd*bmp;
efcomp, order:=0, radius:=1, DKN := {ANGB*bmp*csnkDip, dk1*csnkK1};
print, text="A20";
value, ANGB*bmp;




