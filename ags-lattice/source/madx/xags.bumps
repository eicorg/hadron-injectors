efcomp, order=0, radius=1, DKN := {ANGA*bmp, dk1};

select, flag=error, clear=true;
select, flag=error, range=MM_J18CF;
  n =   5;
  I =   J10_BLW_I;
  bmp = blw_c * n * I / (MOM);
  dk1 = 1*k1cf * bmp ;
efcomp, order=0, radius=1, DKN := {ANGC*bmp, dk1};

select, flag=error, clear=true;
select, flag=error, range=MM_J19BD;
  n =   6;
  I =   J10_BLW_I;
  bmp = blw_c * n * I / (MOM);
  dk1 = -1*k1bd * bmp;
efcomp, order=0, radius=1, DKN := {ANGB*bmp, dk1};

select, flag=error, clear=true;
select, flag=error, range=MM_K12BD;
  n =   6;
  I =   -1*J10_BLW_I;
  bmp = blw_c * n * I / (MOM);
  dk1 = 1*k1bd * bmp ;
efcomp, order=0, radius=1, DKN := {ANGB*bmp, dk1};

select, flag=error, clear=true;
select, flag=error, range=MM_K13CF;
  n =   5;
  I =   -1*J10_BLW_I;
  bmp = blw_c * n * I / (MOM);
  dk1 = -1*k1cf* bmp ;
efcomp, order=0, radius=1, DKN := {ANGC*bmp, dk1};

//print, "HERE";

select, flag=error, clear=true;
//print, "HERE";

return;
