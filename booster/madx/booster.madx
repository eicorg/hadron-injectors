option, -echo;
title, "AGS BOOSTER";

Q := 1;
NN := 1;

! Keep the original MAD-X evaluation order: conversions, definitions,
! beamlines, then the selected operating state.
call, file = "conversions.madx";
call, file = "elements/elements.madx";
call, file = "beamlines/beamlines.madx";
call, file = "states/baseline.madx";

beam, mass = E0*NN, charge = Q, energy = E0*GAMMA*NN, sigt = 1.0;
use, period = BOOSTER;
return;
