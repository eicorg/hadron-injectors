IQVTC1:=    0.0      ;   //5.004025E+01
IQVTB7:=    0.0      ;   //5.509942E+01
IQVTB5:=    0.0      ;   //-6.187398E+01

IQHTD4:=    0.0      ;   //3.143064E-01
IQHTD2:= -600.0*bfact;         //-1.004271E+02 -1000 -600
